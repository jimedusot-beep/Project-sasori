{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sasori protocol trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "label",
    "model",
    "firmware",
    "transport",
    "evidence",
    "sourceNote",
    "payloadsIncluded",
    "frames",
    "markers"
  ],
  "properties": {
    "format": {
      "const": "sasori.trace"
    },
    "schemaVersion": {
      "const": 1
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "firmware": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "sourceNote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "transport": {
      "enum": ["ble", "serial", "audio", "infrared", "other"]
    },
    "evidence": {
      "enum": ["synthetic", "owner-observed", "community-reported"]
    },
    "payloadsIncluded": {
      "type": "boolean"
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tMs", "direction", "endpoint", "length"],
        "properties": {
          "tMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400000
          },
          "direction": {
            "enum": ["tx", "rx"]
          },
          "endpoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_.:-]+$"
          },
          "length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1024
          },
          "hex": {
            "type": "string",
            "maxLength": 3072,
            "pattern": "^(?:[a-f0-9]{2}(?: |$))*$"
          }
        }
      }
    },
    "markers": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tMs", "label"],
        "properties": {
          "tMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400000
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "payloadsIncluded": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "frames": {
            "items": {
              "not": {
                "required": ["hex"]
              }
            }
          }
        }
      }
    }
  ]
}
