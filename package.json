{
  "name": "project-sasori",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Mobile animatronics research laboratory; inspection-only live BLE",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "review:elmo": "node scripts/elmo-capture-review.mjs",
    "handoff:rea": "node scripts/rea-handoff.mjs",
    "test:browser": "playwright test",
    "security": "node scripts/security.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run security"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
